  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:pdf": "node scripts/build-pdfs.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --test",
    "test:site": "node --test $(find . \\( -name node_modules -o -name dist -o -name '.?*' -o -path ./test/submissions -o -path ./test/status \\) -prune -o -name '*.test.mjs' -print)",
    "test:submissions": "node --test test/submissions/*.test.mjs",
    "test:status": "node --test test/status/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@sveltia/cms": "0.210.3",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.16.11",
    "leaflet": "^1.9.4",
    "tailwindcss": "^4.1.18",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/leaflet": "1.9",
    "playwright-core": "1.65.1",
    "typescript": "^5.9.3"
  }
}
