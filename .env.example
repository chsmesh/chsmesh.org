# --- Build time (baked into the static site) ---------------------------------
# PUBLIC_ values are inlined into the static JavaScript, so they are visible to
# anyone who loads the site. docker-compose.yml forwards them to the Dockerfile
# as build args, so changing one requires a rebuild - restarting the container
# is not enough.
#
# Path prefix the forms POST to, as <base>/<kind>. Optional; defaults to
# /api/submit. Must be a same-origin path: connect-src is 'self'.
# PUBLIC_SUBMIT_BASE=/api/submit

# --- Same-origin submissions service (services/submissions) ------------------
# Public origin of the site; submissions from other origins are refused and
# the CMS token is only ever posted back to this origin.
SITE_ORIGIN=https://chsmesh.org
# Fine-grained personal access token (or GitHub App token) for GITHUB_REPO with
# Contents: read/write and Pull requests: read/write. Server-side only.
GITHUB_TOKEN=
GITHUB_REPO=chsmesh/chsmesh.org
GITHUB_BASE_BRANCH=main
# Private moderators channel: receives each PR link plus the submitter email,
# which is deliberately kept out of the public pull request.
DISCORD_WEBHOOK_URL=
# Optional Cloudflare Turnstile bot protection for the public forms. The site
# key is public and baked into the build like the webhook URLs (rebuild to
# change it); when set, every form renders the widget. The secret is
# server-side only; when set, the submissions service rejects any submission
# without a token that Cloudflare verifies for this site's hostname and the
# form's `submit-<kind>` action. Set both or neither. The widget's allowed
# hostnames in the Cloudflare dashboard must include chsmesh.org and, for
# local testing, localhost.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# GitHub OAuth App for the CMS at /admin/. Authorization callback URL must be
# ${SITE_ORIGIN}/api/auth/callback. Leave empty to disable CMS sign-in.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
