# n8n Webhook URLs for form submissions
# Get these from your n8n workflow webhook triggers
#
# These are PUBLIC_ values on purpose: Astro inlines them into the static
# JavaScript, so they are visible to anyone who loads the site. They are baked
# in at BUILD time (docker-compose.yml forwards them to the Dockerfile as build
# args), so rotating a webhook URL requires rebuilding and redeploying the
# image - restarting the container is not enough.
#
# The origins (scheme://host) of ALL FOUR webhook URLs are substituted into the
# CSP connect-src in security-headers.conf during the build, so the webhooks may
# live on different hosts. Leave them unset and the browser will block form
# submissions. A value that is not a plain http(s) URL fails the image build.
#
# Because the URLs are public, every webhook must do its own validation, spam
# filtering and rate limiting inside n8n.
PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/submit-node
PUBLIC_N8N_GUIDES_WEBHOOK_URL=https://your-n8n-instance.com/webhook/submit-guide
PUBLIC_N8N_MEETUPS_WEBHOOK_URL=https://your-n8n-instance.com/webhook/submit-meetup
PUBLIC_N8N_RESOURCES_WEBHOOK_URL=https://your-n8n-instance.com/webhook/submit-resource

# --- Same-origin submissions service (services/submissions) ------------------
# To route the public forms through it instead of n8n, point the four webhook
# URLs above at its paths; a leading "/" keeps connect-src at 'self':
#   PUBLIC_N8N_WEBHOOK_URL=/api/submit/node
#   PUBLIC_N8N_GUIDES_WEBHOOK_URL=/api/submit/guide
#   PUBLIC_N8N_MEETUPS_WEBHOOK_URL=/api/submit/meetup
#   PUBLIC_N8N_RESOURCES_WEBHOOK_URL=/api/submit/resource
#
# Public origin of the site; submissions from other origins are refused and
# the CMS token is only ever posted back to this origin.
SITE_ORIGIN=https://chsmesh.org
# Fine-grained personal access token (or GitHub App token) for GITHUB_REPO with
# Contents: read/write and Pull requests: read/write. Server-side only.
GITHUB_TOKEN=
GITHUB_REPO=chsmesh/chsmesh.org
GITHUB_BASE_BRANCH=main
# Private moderators channel: receives each PR link plus the submitter email,
# which is deliberately kept out of the public pull request.
DISCORD_WEBHOOK_URL=
# Optional Cloudflare Turnstile secret; when set, submissions must carry a
# valid `turnstileToken` (the form does not render the widget yet).
TURNSTILE_SECRET=
# GitHub OAuth App for the CMS at /admin/. Authorization callback URL must be
# ${SITE_ORIGIN}/api/auth/callback. Leave empty to disable CMS sign-in.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
