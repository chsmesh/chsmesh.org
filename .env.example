# n8n Webhook URLs for form submissions
# Get these from your n8n workflow webhook triggers
#
# These are PUBLIC_ values on purpose: Astro inlines them into the static
# JavaScript, so they are visible to anyone who loads the site. They are baked
# in at BUILD time (docker-compose.yml forwards them to the Dockerfile as build
# args), so rotating a webhook URL requires rebuilding and redeploying the
# image - restarting the container is not enough.
#
# The origin of PUBLIC_N8N_WEBHOOK_URL is also substituted into the CSP
# connect-src in security-headers.conf during the build. Leave it unset and the
# browser will block form submissions.
#
# Because the URLs are public, every webhook must do its own validation, spam
# filtering and rate limiting inside n8n.
PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/submit-node
PUBLIC_N8N_GUIDES_WEBHOOK_URL=https://your-n8n-instance.com/webhook/submit-guide
PUBLIC_N8N_MEETUPS_WEBHOOK_URL=https://your-n8n-instance.com/webhook/submit-meetup
PUBLIC_N8N_RESOURCES_WEBHOOK_URL=https://your-n8n-instance.com/webhook/submit-resource
