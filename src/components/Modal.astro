---
// Modal component for displaying content in an overlay
interface Props {
  id: string;
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
}

const { id, size = 'lg' } = Astro.props;

const sizeClasses = {
  sm: 'max-w-md',
  md: 'max-w-2xl',
  lg: 'max-w-4xl',
  xl: 'max-w-6xl',
  full: 'max-w-full mx-4',
};
---

<div id={id} class="modal hidden" role="dialog" aria-modal="true">
  <div class="modal-backdrop" data-modal-close={id}></div>
  <div class={`modal-content ${sizeClasses[size]}`}>
    <div class="modal-body">
      <div class="modal-frame">
        <button
          type="button"
          class="modal-close modal-close-float"
          data-modal-close={id}
          aria-label="Close modal"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <slot />
      </div>
    </div>
  </div>
</div>

<style>
  .modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .modal.hidden {
    display: none;
  }

  .modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
    cursor: pointer;
  }

  .modal-content {
    position: relative;
    background: transparent;
    border-radius: 0;
    box-shadow: none;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    width: 100%;
    z-index: 10;
  }

  .modal-body {
    padding: 0;
    overflow: visible;
    flex: 1;
    max-height: 90vh;
    display: flex;
    justify-content: center;
  }

  .modal-frame {
    position: relative;
    width: 100%;
  }

  .modal-body :global(.card) {
    max-height: 90vh;
    overflow-y: auto;
  }

  .modal-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.375rem;
    color: #6b7280;
    transition: all 0.15s ease-in-out;
    flex-shrink: 0;
  }

  .modal-close-float {
    position: absolute;
    top: -0.75rem;
    right: -0.75rem;
    z-index: 20;
    background: white;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.12);
  }

  .modal-close:hover {
    background-color: #f3f4f6;
    color: #111827;
  }

  /* Prevent body scroll when modal is open */
  :global(body.modal-open) {
    overflow: hidden;
  }
</style>

<script>
  // Modal management
  const FOCUSABLE_SELECTOR = [
    'a[href]',
    'button:not([disabled])',
    'input:not([disabled]):not([type="hidden"])',
    'select:not([disabled])',
    'textarea:not([disabled])',
    '[tabindex]:not([tabindex="-1"])',
  ].join(', ');

  // Remembers which element opened each modal so focus can be restored on close.
  const openerByModal = new WeakMap<HTMLElement, HTMLElement>();

  function getFocusable(modal: HTMLElement): HTMLElement[] {
    return Array.from(modal.querySelectorAll<HTMLElement>(FOCUSABLE_SELECTOR)).filter(
      (el) => el.getClientRects().length > 0,
    );
  }

  function openModal(modal: HTMLElement) {
    const opener = document.activeElement;
    if (opener instanceof HTMLElement) {
      openerByModal.set(modal, opener);
    } else {
      openerByModal.delete(modal);
    }

    modal.classList.remove('hidden');
    document.body.classList.add('modal-open');

    // Move focus into the dialog: first visible form control if there is one,
    // else the first focusable element (the close button), else the dialog itself.
    const focusable = getFocusable(modal);
    const firstField = focusable.find((el) =>
      ['INPUT', 'TEXTAREA', 'SELECT'].includes(el.tagName),
    );
    const target = firstField ?? focusable[0] ?? modal;
    if (target === modal && !modal.hasAttribute('tabindex')) {
      modal.setAttribute('tabindex', '-1');
    }
    setTimeout(() => target.focus(), 100);
  }

  function closeModal(modal: HTMLElement) {
    if (modal.classList.contains('hidden')) return;
    modal.classList.add('hidden');
    document.body.classList.remove('modal-open');

    // Restore focus to whatever opened the modal.
    const opener = openerByModal.get(modal);
    openerByModal.delete(modal);
    if (opener && opener.isConnected) {
      opener.focus();
    }
  }

  // Keep Tab / Shift+Tab inside the open dialog.
  function trapFocus(modal: HTMLElement, e: KeyboardEvent) {
    const focusable = getFocusable(modal);
    if (focusable.length === 0) {
      e.preventDefault();
      return;
    }

    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    const active = document.activeElement;

    if (!(active instanceof HTMLElement) || !modal.contains(active)) {
      e.preventDefault();
      (e.shiftKey ? last : first).focus();
      return;
    }

    if (e.shiftKey && active === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && active === last) {
      e.preventDefault();
      first.focus();
    }
  }

  function initModals() {
    // Open modal
    document.querySelectorAll('[data-modal-open]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const modalId = trigger.getAttribute('data-modal-open');
        const modal = modalId ? document.getElementById(modalId) : null;
        if (modal) {
          openModal(modal);
        }
      });
    });

    // Close modal (close button and backdrop)
    document.querySelectorAll('[data-modal-close]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const modalId = trigger.getAttribute('data-modal-close');
        const modal = modalId ? document.getElementById(modalId) : null;
        if (modal) {
          closeModal(modal);
        }
      });
    });

    // Escape closes, Tab stays trapped inside the open dialog
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' && e.key !== 'Tab') return;

      const openModalEl = document.querySelector<HTMLElement>('.modal:not(.hidden)');
      if (!openModalEl) return;

      if (e.key === 'Escape') {
        closeModal(openModalEl);
      } else {
        trapFocus(openModalEl, e);
      }
    });
  }

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initModals);
  } else {
    initModals();
  }
</script>
