---
import Layout from '../../layouts/Layout.astro';
import OfflineIndicator from '../../components/OfflineIndicator.astro';
import MeshSettings from '../../components/MeshSettings.astro';
import { getCollection, render } from 'astro:content';
import { getTaxonomyLabels } from '../../utils/taxonomy';
import { getGlobal } from '../../utils/global';
import { guideShareCard } from '../../utils/shareCards';
import { guidePdfHref } from '../../utils/downloads.mjs';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const { title, description, difficulty, category, readingTime, prerequisites, lastUpdated, author, meshSettings } = guide.data;
const guidesDetail = await getGlobal('guides-detail', 'guides-detail');
const labels = await getTaxonomyLabels();
const difficultyLabel = labels.guideDifficulties[difficulty] ?? difficulty;
const categoryLabel = labels.guideCategories[category] ?? category;
const shareCard = guideShareCard(guide, labels);

const difficultyColors = {
  beginner: 'badge-beginner',
  intermediate: 'badge-intermediate',
  advanced: 'badge-advanced',
};

// Get related guides in the same category
const allGuides = await getCollection('guides');
const relatedGuides = allGuides
  .filter((g) => g.data.category === category && g.id !== guide.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const reportUrl = guidesDetail.feedback.reportUrlTemplate.replace('{title}', encodeURIComponent(title));
---

<Layout title={title} description={description} ogImage={shareCard.path} ogImageAlt={shareCard.alt} ogType="article">
  <article>
    <!-- Header -->
    <section class="hero hero-pattern py-12">
      <div class="container-narrow">
        <nav class="mb-6 no-print">
          <a href="/guides/" class="transition-colors inline-flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            {guidesDetail.backLabel}
          </a>
        </nav>

        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class={difficultyColors[difficulty]}>{difficultyLabel}</span>
          <span class="badge bg-white/20 text-white">{categoryLabel}</span>
          {readingTime && (
            <span class="text-sm text-primary-200 flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {readingTime} min read
            </span>
          )}
        </div>

        <h1 class="text-white mb-4">{title}</h1>
        <p class="text-xl text-primary-100">{description}</p>

        {(author || lastUpdated) && (
          <div class="mt-6 text-sm text-primary-200 flex flex-wrap gap-4">
            {author && <span>By {author}</span>}
            {lastUpdated && (
              <span>
                Updated {lastUpdated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
              </span>
            )}
          </div>
        )}

        {/* Generated after the build by scripts/build-pdfs.mjs, so this link
            is dead under `astro dev` and a plain `npm run build`. */}
        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 no-print">
          <a href={guidePdfHref(guide.slug)} download class="btn btn-sm hero-btn">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3" />
            </svg>
            {guidesDetail.download.label}
          </a>
          <span class="text-sm text-primary-100">{guidesDetail.download.hint}</span>
          <OfflineIndicator class="text-primary-100" />
        </div>
      </div>
    </section>

    <!-- Prerequisites -->
    {prerequisites.length > 0 && (
      <section class="prereqs bg-accent-50 border-b border-accent-200">
        <div class="container-narrow">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <h4 class="font-medium text-accent-800 mb-1">{guidesDetail.prerequisitesHeading}</h4>
              <ul class="text-sm text-accent-700">
                {prerequisites.map((prereq) => (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 bg-accent-400 rounded-full"></span>
                    {prereq}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Content -->
    <section class="section-sm">
      <div class="container-narrow">
        {meshSettings && <MeshSettings />}
        <div class="prose max-w-none">
          <Content />
        </div>
      </div>
    </section>

    <!-- Related Guides -->
    {relatedGuides.length > 0 && (
      <section class="section-sm bg-neutral-50 border-t border-neutral-200 no-print">
        <div class="container-narrow">
          <h3 class="text-xl font-semibold mb-6">{guidesDetail.relatedHeading}</h3>
          <div class="grid gap-4">
            {relatedGuides.map((related) => (
              <a href={`/guides/${related.slug}/`} class="card card-body flex items-center gap-4 hover:border-primary-300 transition-colors">
                <div class="flex-grow">
                  <h4 class="font-medium text-neutral-900">{related.data.title}</h4>
                  <p class="text-sm text-neutral-500 line-clamp-1">{related.data.description}</p>
                </div>
                <svg class="w-5 h-5 text-neutral-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Feedback -->
    <section class="section-sm border-t border-neutral-200 no-print">
      <div class="container-narrow text-center">
        <p class="text-neutral-600 mb-4">{guidesDetail.feedback.question}</p>
        <div class="flex justify-center gap-4">
          <a href={reportUrl} target="_blank" rel="noopener noreferrer" class="btn-outline btn-sm">
            {guidesDetail.feedback.reportLabel}
          </a>
          <a href={guidesDetail.feedback.improveUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost btn-sm">
            {guidesDetail.feedback.improveLabel}
          </a>
        </div>
      </div>
    </section>
  </article>
</Layout>
