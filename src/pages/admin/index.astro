---
// Sveltia CMS shell, served at /admin/. The CMS bundle is imported from npm so
// Vite emits it as a hashed /_astro/ file and the site-wide CSP of
// script-src 'self' still holds; the wider connect-src the admin page needs
// is spliced in by nginx (see security-headers.conf and nginx.conf).
// The CMS reads its configuration from the cms-config-url link below.
// See docs/cms-and-submissions.md.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>CHS Mesh CMS</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link href="/admin/config.yml" type="application/yaml" rel="cms-config-url" />
  </head>
  <body>
    <script>
      import '@sveltia/cms';
    </script>
  </body>
</html>
